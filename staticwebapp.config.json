{
  "auth": {
    "rolesSource": "/api/GetRoles",
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/3dbca1c1-887b-4351-b72d-3dbb88096389/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    { "route": "/.auth/*", "allowedRoles": ["anonymous", "authenticated", "acceso", "interno"] },
    { "route": "/api/GetRoles", "allowedRoles": ["anonymous", "authenticated", "acceso", "interno"] },
    { "route": "/accesos", "rewrite": "/acceso.html", "allowedRoles": ["acceso", "interno"] },
    { "route": "/acceso.html", "allowedRoles": ["acceso", "interno"] },
    { "route": "/api/solicitudes-acceso/*", "allowedRoles": ["acceso", "interno"] },
    { "route": "/api/solicitudes-acceso", "allowedRoles": ["acceso", "interno"] },
    { "route": "/api/grupos-acceso", "allowedRoles": ["acceso", "interno"] },
    { "route": "/api/usuarios", "allowedRoles": ["acceso", "interno"] },
    { "route": "/*", "allowedRoles": ["interno"] }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    },
    "403": {
      "redirect": "/accesos",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/.auth/*"]
  }
}
